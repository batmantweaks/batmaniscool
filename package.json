{
  "name": "batmaniscool",
  "version": "4.7.3",
  "description": "batmaniscool - Ultimate PC Optimizer & System Tweak Suite",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-packager . batmaniscool --platform=win32 --arch=x64 --out=dist --overwrite",
    "test:engine": "node tests/engine-tests.cjs && node tests/power-engine-tests.cjs",
    "test:ui": "electron tests/ui-smoke.cjs",
    "dist:installer": "electron-builder --win nsis --x64",
    "dist:unsigned": "electron-builder --win nsis --x64 --publish never"
  },
  "keywords": [
    "batmaniscool",
    "batcomputer",
    "pc-optimizer",
    "electron",
    "tweaks"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.5.1",
    "electron-updater": "^6.8.9"
  }
}
